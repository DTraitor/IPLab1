<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/css" href="part1.css" ?>
<hotelSignInForm>
    <form>
        <label for="firstName">First Name:</label>
        <input type="text" id="firstName" name="firstName"  />

        <label for="lastName">Last Name:</label>
        <input type="text" id="lastName" name="lastName"  />

        <label for="rooms">Number of Rooms:</label>
        <input type="number" id="rooms" name="rooms" min="1"  />

        <label for="specialRequirements">Special Requirements:</label>
        <textarea id="specialRequirements" name="specialRequirements"></textarea>

        <label for="duration">Duration of Stay (in days):</label>
        <input type="number" id="duration" name="duration" min="1"  />

        <button type="submit">Sign In</button>
    </form>
</hotelSignInForm>
